# Copy to .env and fill in real values before running `docker compose up`.

# Required: replace with a long random string (e.g. openssl rand -hex 32)
MTWG_JWT_SECRET=change-me-to-a-long-random-string

# Allowed CORS origin(s). Not needed for the normal single-port deployment
# (frontend and API are same-origin); only set this if you call the API
# from a different origin. "*" is for dev only.
MTWG_CORS_ALLOWED_ORIGINS=*

# Initial admin user (only used while the database is still empty)
MTWG_USERNAME=admin
MTWG_PASSWORD=admin

# WireGuard server address as seen by clients (usually the VPS/router's public IP)
MTWG_ENDPOINT_ADDRESS=

# WireGuard's internal VPN network. The server itself owns .1; client IPs
# start from .2 (.0, .1 and .255 are always excluded from suggestion).
MTWG_SERVER_INTERFACE_ADDRESSES=10.252.1.1/24
MTWG_SERVER_LISTEN_PORT=51820

# Email (optional, to send client configs)
MTWG_SMTP_HOSTNAME=
MTWG_SMTP_PORT=25
MTWG_SMTP_USERNAME=
MTWG_SMTP_PASSWORD=
MTWG_EMAIL_FROM_ADDRESS=

# Telegram bot (optional, to send client configs)
MTWG_TELEGRAM_TOKEN=

# Extra subnet ranges (optional), format: name1:cidr1,cidr2;name2:cidr3
MTWG_SUBNET_RANGES=

# Where the locally-written wg0.conf is saved. Default points inside the
# persisted data volume, since /etc/wireguard doesn't exist in the Docker
# image (no wireguard-tools -- this project targets Mikrotik RouterOS 7
# over SSH instead of a local wg0 interface). Only change this if you
# uncommented network_mode: host in docker-compose.yaml and genuinely run
# a local WireGuard interface inside the container.
MTWG_CONFIG_FILE_PATH=/app/data/wg0.conf

# Port published on the host. Single port serves both the API and the
# frontend (the frontend is embedded into the Go binary, see Dockerfile).
APP_PORT=8200
