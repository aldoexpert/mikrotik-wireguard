<template>
  <div class="page" data-name="settings">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left"><a href="#" class="link icon-only panel-open" data-panel=".panel-left"><i class="icon f7-icons if-not-md">menu</i><i class="icon material-icons md-only">menu</i></a></div>
        <div class="title">Global Settings</div>
      </div>
    </div>
    <div class="page-content">
      ${loading ? $h`<div class="block text-align-center"><div class="preloader"></div></div>` : $h`
        <form @submit="${handleSubmit}">
          <div class="list no-hairlines-md">
            <ul>
              <li>
                <div class="item-content item-input">
                  <div class="item-inner">
                    <div class="item-title item-label">Endpoint Address</div>
                    <div class="item-input-wrap"><input type="text" value="${form.endpoint_address}" @input="${(e) => { form.endpoint_address = e.target.value; }}" /></div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content item-input">
                  <div class="item-inner">
                    <div class="item-title item-label">DNS Servers (comma separated)</div>
                    <div class="item-input-wrap"><input type="text" value="${form.dns_servers}" @input="${(e) => { form.dns_servers = e.target.value; }}" /></div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content item-input">
                  <div class="item-inner">
                    <div class="item-title item-label">MTU</div>
                    <div class="item-input-wrap"><input type="number" value="${form.mtu}" @input="${(e) => { form.mtu = e.target.value; }}" /></div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content item-input">
                  <div class="item-inner">
                    <div class="item-title item-label">Persistent Keepalive</div>
                    <div class="item-input-wrap"><input type="number" value="${form.persistent_keepalive}" @input="${(e) => { form.persistent_keepalive = e.target.value; }}" /></div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content item-input">
                  <div class="item-inner">
                    <div class="item-title item-label">Firewall Mark</div>
                    <div class="item-input-wrap"><input type="text" value="${form.firewall_mark}" @input="${(e) => { form.firewall_mark = e.target.value; }}" /></div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content item-input">
                  <div class="item-inner">
                    <div class="item-title item-label">Table</div>
                    <div class="item-input-wrap"><input type="text" value="${form.table}" @input="${(e) => { form.table = e.target.value; }}" /></div>
                  </div>
                </div>
              </li>
              <li>
                <div class="item-content item-input">
                  <div class="item-inner">
                    <div class="item-title item-label">Config File Path</div>
                    <div class="item-input-wrap"><input type="text" value="${form.config_file_path}" @input="${(e) => { form.config_file_path = e.target.value; }}" /></div>
                  </div>
                </div>
              </li>
            </ul>
          </div>
          <div class="block"><button type="submit" class="button button-fill button-large">Save Settings</button></div>
        </form>
      `}
    </div>
  </div>
</template>
<script>
import api, { ApiError } from '../js/api.js';
import { notifySuccess, notifyError, errorMessage } from '../js/notify.js';

export default (props, { $f7, $update }) => {
  let loading = true;
  let form = {
    endpoint_address: '',
    dns_servers: '',
    mtu: '',
    persistent_keepalive: '',
    firewall_mark: '',
    table: '',
    config_file_path: '',
  };

  const load = async () => {
    loading = true;
    $update();
    try {
      const res = await api.get('/wireguard/settings/get');
      const s = res.data;
      form = {
        endpoint_address: s.endpoint_address || '',
        dns_servers: (s.dns_servers || []).join(', '),
        mtu: s.mtu,
        persistent_keepalive: s.persistent_keepalive,
        firewall_mark: s.firewall_mark || '',
        table: s.table || '',
        config_file_path: s.config_file_path || '',
      };
    } catch (err) {
      notifyError($f7, errorMessage(err, ApiError, 'Failed to load the global settings'));
    } finally {
      loading = false;
      $update();
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    try {
      await api.post('/wireguard/settings/update', {
        endpoint_address: form.endpoint_address,
        dns_servers: form.dns_servers.split(',').map((s) => s.trim()).filter(Boolean),
        mtu: String(form.mtu),
        persistent_keepalive: String(form.persistent_keepalive),
        firewall_mark: form.firewall_mark,
        table: form.table,
        config_file_path: form.config_file_path,
      });
      notifySuccess($f7, 'Settings saved. Don\'t forget to "Apply Configuration" on the Server page.');
    } catch (err) {
      notifyError($f7, errorMessage(err, ApiError, 'Failed to save the settings'));
    } finally {
      $update();
    }
  };

  load();

  return $render;
};
</script>
